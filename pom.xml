<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vitorsilverio</groupId>
    <artifactId>armbox</artifactId>
    <version>1.0-SNAPSHOT</version>

    <licenses>
        <license>
            <name>BSD-3-Clause</name>
            <url>https://opensource.org/license/bsd-3-clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Mesma versão do Truffle usada pelo módulo arm-jitter-truffle (A2/A4) e do
             GraalVM instalado pelo usuário para a A5 (E:\graalvm-jdk-25.0.3+9.1). -->
        <truffle.version>25.0.1</truffle.version>
        <graal.sdk.version>25.0.3</graal.sdk.version>
        <native.maven.plugin.version>0.11.1</native.maven.plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vitorsilverio</groupId>
            <artifactId>arm-jitter</artifactId>
            <version>1.3.0</version>
        </dependency>
        <!-- Backend Truffle (task A5): único backend que compila blocos em runtime dentro de
             native-image (o backend ASM define classes em runtime, incompatível). -->
        <dependency>
            <groupId>dev.vitorsilverio</groupId>
            <artifactId>arm-jitter-truffle</artifactId>
            <version>1.3.0</version>
        </dependency>
        <!-- ImageInfo.inImageCode(): permite ao armbox detectar em runtime se está rodando
             dentro de um binário native-image e recusar o backend ASM com mensagem clara
             (armadilha da A5), em vez de estourar UnsupportedOperationException obscura do
             ASM/`defineClass`. Biblioteca leve, funciona em qualquer JVM (devolve false fora
             de native-image), por isso não é escopo=provided. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graal.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Sem a versão no nome: `mvn package` produz `target/armbox.jar` (não
             `armbox-1.0-SNAPSHOT.jar`), exatamente o que o README manda executar. -->
        <finalName>armbox</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>dev.vitorsilverio.armbox.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- `java -jar target/armbox.jar` tem que funcionar sozinho: o jar do
                 maven-jar-plugin não traz o arm-jitter nem o resto do classpath. O shade
                 empacota TODAS as dependências de runtime num uber-jar executável e o
                 grava por cima de `target/armbox.jar` (o jar fino vai para
                 `original-armbox.jar`). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.vitorsilverio.armbox.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <!-- Truffle (arm-jitter-truffle / GraalVM) usa
                                     META-INF/services — sem merge, só o último jar vence. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Task A5: `mvn -Pnative -DskipTests package` com JAVA_HOME apontando para o
             GraalVM 25 (native-image só existe nessa distribuição, não no JBR do resto do
             projeto). Ver tasks/trilha-a-truffle/RELATORIO-A5.md para os passos completos. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <mainClass>dev.vitorsilverio.armbox.Main</mainClass>
                            <imageName>armbox</imageName>
                            <buildArgs>
                                <!-- Ativa a compilação em runtime (Graal) dentro do binário
                                     nativo para o backend Truffle — sem isso o interpretador
                                     Truffle roda sempre no tier frio (aceite #2 da A5). -->
                                <buildArg>--enable-monitoring=jfr</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <!-- Task A8: PGO+O3 venceu as 4 métricas (startup, throughput
                                     truffle/interp, RSS) contra baseline/-O3/-O3+march=native
                                     (G1 indisponível no Windows). Perfil gerado do workload de
                                     referência (busybox loop 2000 + hello.elf), ver
                                     native-profile/default.iprof e tasks/trilha-a-truffle/
                                     RELATORIO-A5.md#a8 para o procedimento de regeneração. -->
                                <buildArg>--pgo=native-profile/default.iprof</buildArg>
                                <buildArg>-O3</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
